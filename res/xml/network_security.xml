<?xml version="1.0" encoding="utf-8"?>
<!-- Android 7.0 belum memuat root Let's Encrypt (ISRG). Root disertakan di sini; di Android yang lebih baru
     isinya sama dengan bawaan sistem. -->
<network-security-config>
    <base-config>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
